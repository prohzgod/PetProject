# Copy to .env.local and fill in the keys from https://my.payos.vn
# (Kênh thanh toán → your payment channel → Thông tin tích hợp).
# Leave them empty to run the store in mock mode with a simulated payOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public URL of this app, used for the payOS return/cancel URLs.
# Defaults to the URL of the incoming request.
# APP_URL=https://your-tunnel.ngrok-free.app
